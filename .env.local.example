# Copy this file to .env.local (or .env) and fill in real values.
# Never commit the filled-in file — .gitignore already excludes .env*.

# --- Database (cPanel MariaDB) ---
DATABASE_URL="mysql://db_user:db_password@db_host/db_name"

# --- Auth ---
NEXTAUTH_SECRET="generate-a-random-secret-e.g-openssl-rand-hex-32"
# Optional — NextAuth v5 can auto-detect this from the request; only set
# it if you need to pin a specific public URL.
NEXTAUTH_URL="https://your-deployment-url"

# --- SMTP (mailbox used to send PIC/share emails) ---
SMTP_HOST="mail.yourdomain.com"
SMTP_PORT=465
SMTP_USER="sender@yourdomain.com"
SMTP_PASS="smtp-account-password"
SMTP_FROM="Your Company <sender@yourdomain.com>"

# --- Guest self-registration ---
# Comma-separated list of email domains allowed to self-register as Guest.
GUEST_EMAIL_DOMAINS="yourdomain.com,gmail.com"

# --- Admin seed account (used once by prisma/seed.ts) ---
SEED_ADMIN_NAME="Admin"
SEED_ADMIN_EMAIL="admin@yourdomain.com"
SEED_ADMIN_PASSWORD="choose-a-strong-password"

# --- File storage (cPanel FTP) ---
# Create/confirm an FTP account in cPanel > FTP Accounts. FTP_BASE_DIR is
# relative to that account's FTP root (leave empty if the account is
# already jailed to the intended upload folder).
FTP_HOST="ftp.yourdomain.com"
FTP_USER="ftp-username"
FTP_PASSWORD="ftp-password"
FTP_BASE_DIR=""
